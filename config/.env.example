# Copy this file to .env and fill in your values.
# The pipeline works without any key — LLM is only used with --use-llm.

# Groq API key  (free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Optional: override the default Groq model
# Available options: llama-3.3-70b-versatile | llama3-8b-8192 | mixtral-8x7b-32768
# MCQ_LLM_MODEL=llama-3.3-70b-versatile
